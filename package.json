{
  "name": "pos-inventory-warehouse",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @pos/client dev",
    "build": "pnpm --filter @pos/client build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:db": "node scripts/test-db.mjs",
    "check": "node scripts/check.mjs",
    "test:functions": "vitest run --dir supabase/functions",
    "smoke:users": "node scripts/smoke-users.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "supabase": "^3.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
